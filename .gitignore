# ================================
# e-Karya Git Ignore
# ================================

# Dependencies
node_modules/
server/node_modules/
web/node_modules/

# Environment variables / secrets
.env
.env.*
server/.env
server/.env.*
web/.env
web/.env.*

# Allow example environment files
!.env.example
!server/.env.example
!web/.env.example

# Build outputs
dist/
build/
server/dist/
web/dist/

# Vite
.vite/
web/.vite/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Coverage
coverage/
.nyc_output/

# Temporary files
*.tmp
*.temp

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor settings
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# IDE files
.idea/
*.iml

# Local database / generated files
*.sqlite
*.sqlite3
*.db

# Prisma generated/local files
server/prisma/*.db
server/prisma/*.db-journal

# Cache
.cache/
.parcel-cache/

# Backup files
*.bak
*.swp