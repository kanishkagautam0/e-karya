# =========================
# e-Karya - Git Ignore
# =========================

# Dependencies
node_modules/
**/node_modules/

# Environment variables / secrets
.env
.env.*
**/.env
**/.env.*

# Allow example environment files
!.env.example
!**/.env.example

# Build files
dist/
build/
**/dist/
**/build/
.vite/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Database / local data
*.db
*.sqlite
*.sqlite3
*.sqlite-journal

# Coverage
coverage/
.nyc_output/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor / IDE
.vscode/
.idea/
*.iml

# Temporary / backup files
*.tmp
*.temp
*.bak
*.swp

# Local secrets / certificates
*.pem
*.key
*.crt
*.p12

# Prisma
**/.prisma/